# Copy to `.env.development` for local (non-Docker) runs. Docker Compose sets
# these itself; see docker-compose.yaml.

LOG_LEVEL=INFO
DB_ECHO_SQL=False

# Backend database (Compose uses the `postgres` service name as DB_HOST)
DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Backend: the demo principal injected into every request. Roles: admin | viewer
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_NICKNAME=Demo User
DEMO_USER_ROLES=admin

# GraphQL server
GRAPHQL_PORT=4000
BACKEND_API_URL=http://localhost:8000
# The organisation the dashboard opens by default (created by scripts/seed.py)
DEFAULT_ORG_UID=a4e22a6a-a062-4436-90c6-c51635c03fa7

# Dashboard server (serves the SPA and proxies /api to the GraphQL server)
GRAPHQL_PROXY_URL=http://localhost:4000
GRAPHQL_PROXY_TIMEOUT=17
