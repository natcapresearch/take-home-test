{
    "name": "take-home-test",
    "packageManager": "pnpm@9.12.3",
    "version": "1.0.0",
    "description": "",
    "type": "module",
    "browserslist": "> 0.5%, last 2 versions, not dead",
    "scripts": {
        "clean": "rm -rf ./dist ./.parcel-cache",
        "build": "parcel build src/ui/dashboard/index.html --public-url /",
        "verify": "pnpm run test && pnpm run fix && pnpm run check",
        "check": "pnpm run graphql-generate && pnpm run check-graphql && pnpm run check-ui",
        "check-graphql": "tsc --noEmit --project src/graphql",
        "check-ui": "tsc --noEmit --project src/ui",
        "fix": "pnpm run lint-fix && pnpm run fmt",
        "gen": "poetry run python -m src.backend.cli gen-api-spec && pnpm run graphql-generate-backend && pnpm run graphql-generate",
        "lint": "eslint ./src && prettier -c ./src",
        "lint-fix": "eslint ./src --fix",
        "fmt": "prettier --write '**/*.{ts,tsx,js,css,scss,html,json,md}'",
        "fmt-check": "prettier --check",
        "fmt-check-all": "prettier --check '**/*.{ts,tsx,js,css,scss,html,json,md}'",
        "test": "jest",
        "graphql-generate-watch": "pnpm run graphql-generate --watch",
        "graphql-compile": "pnpm run graphql-generate-backend && pnpm run graphql-generate && tsx",
        "graphql-generate": "graphql-codegen --config src/graphql/codegen.yaml",
        "graphql-generate-backend": "openapi-ts && sed -i.bak 's/\\x27Don\\x27t know\\x27/\\x22Don\\x27t know\\x22/' src/graphql/__generated__/backend/types.gen.ts && rm src/graphql/__generated__/backend/types.gen.ts.bak",
        "start-dashboard": "parcel src/ui/dashboard/index.html --no-cache",
        "start-graphql": "tsx watch --tsconfig src/graphql/tsconfig.json src/graphql/src/app.ts"
    },
    "lint-staged": {
        "*.{ts,tsx,js}": [
            "pnpm lint",
            "pnpm fmt-check"
        ],
        "*.{css,scss,html,json}": "pnpm fmt-check"
    },
    "pnpm": {
        "overrides": {
            "p-queue": "^6.6.2",
            "highcharts": "-",
            "@smithy/config-resolver@<=4.4.0": "4.4.0",
            "qs@<=6.14.2": "6.14.2",
            "body-parser@<=1.20.4": "1.20.4",
            "test-exclude>minimatch": "5.1.6"
        },
        "peerDependencyRules": {
            "allowedVersions": {
                "@types/react": "19",
                "@types/react-dom": "19",
                "react": "19",
                "react-dom": "19"
            }
        }
    },
    "graphql": {
        "schema": "./src/graphql/resources/schema.graphql",
        "documents": "**/*.{graphql,ts,tsx}"
    },
    "dependencies": {
        "@apollo/client": "^3.9.11",
        "@apollo/datasource-rest": "^6.3.0",
        "@apollo/server": "^5.5.0",
        "@apollo/utils.fetcher": "^3.1.0",
        "@apollo/utils.keyvaluecache": "^3.1.0",
        "@as-integrations/express5": "^1.1.2",
        "@hey-api/client-fetch": "^0.5.4",
        "@twilio-paste/core": "^20.20.0",
        "@twilio-paste/icons": "^12.8.0",
        "@twilio-paste/style-props": "^10.0.1",
        "@types/leaflet": "^1.9.9",
        "@types/react": "^19.0.8",
        "@types/react-dom": "^19.0.3",
        "cors": "^2.8.5",
        "date-fns": "^4.1.0",
        "echarts": "^6.1.0",
        "echarts-for-react": "^3.0.2",
        "express": "^4.22.1",
        "graphql": "^16.8.1",
        "graphql-tag": "^2.12.6",
        "leaflet": "^1.9.4",
        "lodash": "^4.17.23",
        "pino": "^10.1.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-leaflet": "^5.0.0",
        "react-router-dom": "^7.0.0",
        "sanitize-html": "^2.17.3",
        "styled-components": "^6.1.8",
        "tinycolor2": "^1.6.0",
        "tsx": "^4.21.0",
        "uuid": "14.0.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.1.1",
        "@graphql-codegen/cli": "^5.0.2",
        "@graphql-codegen/typed-document-node": "^5.0.6",
        "@graphql-codegen/typescript": "^4.0.6",
        "@graphql-codegen/typescript-resolvers": "^4.0.6",
        "@graphql-eslint/eslint-plugin": "^4.4.0",
        "@graphql-typed-document-node/core": "^3.2.0",
        "@hey-api/openapi-ts": "^0.97.3",
        "@parcel/config-default": "^2.14.4",
        "@parcel/core": "^2.14.4",
        "@parcel/transformer-graphql": "^2.14.4",
        "@parcel/transformer-js": "^2.14.4",
        "@parcel/transformer-raw": "^2.14.4",
        "@parcel/transformer-react-refresh-wrap": "^2.14.4",
        "@testing-library/jest-dom": "^6.4.2",
        "@testing-library/react": "^15.0.2",
        "@testing-library/user-event": "^14.5.2",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/geojson": "^7946.0.15",
        "@types/jest": "^29.5.12",
        "@types/lodash": "^4.17.7",
        "@types/node": "^22.0.0",
        "@types/sanitize-html": "^2.16.1",
        "@types/tinycolor2": "^1.4.6",
        "buffer": "^5.5.0||^6.0.0",
        "eslint": "^9.1.0",
        "eslint-plugin-react": "^7.34.1",
        "eslint-plugin-react-hooks": "^5.1.0",
        "http-proxy-middleware": "^3.0.3",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "jest-fixed-jsdom": "^0.0.7",
        "lint-staged": "^15.2.2",
        "parcel": "^2.14.4",
        "prettier": "3.0.2",
        "ts-jest": "^29.4.6",
        "typescript": "5.9.3",
        "typescript-eslint": "^7.7.0"
    },
    "@parcel/resolver-default": {
        "packageExports": true
    },
    "keywords": []
}
